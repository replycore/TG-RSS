# 必填：在 https://my.telegram.org/apps 创建应用后获得
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef

# 必填：账号手机号，国际格式
TG_PHONE=+8613800138000

# 必填：执行 `npm run login` 后打印的会话字符串
TG_SESSION=

# 必填：访问令牌，与 TG-RSS 后台「私密频道桥接 → 访问令牌」保持一致
BRIDGE_TOKEN=change-me-to-a-long-random-string

# 可选：监听端口（默认 8788）
PORT=8788

# 可选：对外可访问的地址（Worker 回源用），留空则用 http://127.0.0.1:$PORT
# 例如 https://tg-bridge.example.com 或 Cloudflare Tunnel 地址
PUBLIC_URL=

# 可选：媒体缓存目录（默认 ./cache）
CACHE_DIR=
