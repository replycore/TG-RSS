{
  // Workers 部署配置模板（复制为 wrangler.deploy.jsonc 后按实际修改；该文件含真实账号/域名，不入库）
  // 复制：cp wrangler.worker.example.jsonc wrangler.deploy.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tg-rss",
  "account_id": "<你的 CF Account ID>",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  // 自定义域名（仅当该域名的 zone 托管在你的 CF 账号内时可用；第三方 DNS 托管的域名请用 Pages）
  // "routes": [{ "pattern": "rss.example.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/rss.xml"]
  },
  "kv_namespaces": [
    {
      "binding": "TG_RSS_KV",
      "id": "<KV namespace id>"
    }
  ]
}